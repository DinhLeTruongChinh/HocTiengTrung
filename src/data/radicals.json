":"Truy","py":"zhǐ","meaning":"Đến ở phía sau","strokes":3},{"stt":35,"radical":"夊","name":"Truy suī","py":"","meaning":"Đi chậm (Liên quan tới hoạt động của chân)","strokes":3},{"stt":36,"radical":"夕","name":"Tịch","py":"xī","meaning":"Đêm tối (Liên quan đến thời gian / hoạt động về đêm)","strokes":3},{"stt":37,"radical":"大","name":"Đại","py":"dà","meaning":"To lớn (Liên quan tới sự việc to lớn hoặc người)","strokes":3},{"stt":38,"radical":"女","name":"Nữ","py":"nǚ","meaning":"Nữ giới, Con gái, Đàn bà (Liên quan tới phụ nữ, sự xinh đẹp hay họ tên)","strokes":3},{"stt":39,"radical":"子","name":"Tử","py":"zi","meaning":"Con (Liên quan tới con cái)","strokes":3},{"stt":40,"radical":"宀","name":"Miên","py":"mián","meaning":"Mái nhà, mái che, (Liên quan tới nhà cửa hay những việc trong nhà)","strokes":3},{"stt":41,"radical":"寸","name":"Thốn","py":"cùn","meaning":"Đơn Vị “Tấc” (Đo\nChiều Dài), liên quan tới phép đo, độ dài","strokes":3},{"stt":42,"radical":"小","name":"Tiểu","py":"xiǎo","meaning":"Nhỏ bé (Liên quan tới các việc nhỏ bé)","strokes":3},{"stt":43,"radical":"尢","name":"Uông","py":"yóu","meaning":"Yếu đuối (Liên quan tới khiếm khuyết, tàn tật)","strokes":3},{"stt":44,"radical":"尸","name":"Thi","py":"shī","meaning":"Xác chết, Thây ma (Liên quan tới thân thể, thi thể hay động tác con người. Có lúc liên quan tới nhà cửa)","strokes":3},{"stt":45,"radical":"屮","name":"Triệt","py":"chè","meaning":"Mầm non, Cỏ non Mới mọc (liên quan tới cỏ)","strokes":3},{"stt":46,"radical":"山","name":"Sơn","py":"shān","meaning":"Núi non (liên quan tới đá, núi)","strokes":3},{"stt":47,"radical":"川、巛","name":"Xuyên","py":"chuān","meaning":"Sông ngòi (liên quan tới sông nước)","strokes":3},{"stt":48,"radical":"工","name":"Công","py":"gōng","meaning":"Người thợ, Công việc (liên quan tới công cụ, người thợ)","strokes":3},{"stt":49,"radical":"己","name":"Kỷ","py":"jǐ","meaning":"Bản thân mình (Liên quan tới trẻ sơ sinh","strokes":3},{"stt":50,"radical":"巾","name":"Cân","py":"jīn","meaning":"Cái